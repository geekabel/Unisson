{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unisson",
  "identifier": "io.github.geekabel.unisson",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Unisson",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#0F1215"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: https: http:",
        "style-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
